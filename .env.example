# Contact form (src/app/api/contact/route.ts).
# Copy to .env.local and fill in. Without these the form returns 503.

# API key from https://resend.com/api-keys
RESEND_API_KEY=

# Sender address. MUST be on a domain verified in Resend, or sending is rejected.
CONTACT_FROM_EMAIL="Adpedia Neo <noreply@adpedia.in>"

# Where enquiries are delivered. Defaults to siteConfig.email if unset.
CONTACT_TO_EMAIL=info@adpedia.in
